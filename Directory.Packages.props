  <ItemGroup>
    <PackageVersion Include="Boutquin.MarketData.Adapter.BankOfCanada" Version="[2.0.1]" />
  </ItemGroup>
  <!-- Explicit stable transitive versions allowed by the restored parent ranges. -->
  <ItemGroup>
